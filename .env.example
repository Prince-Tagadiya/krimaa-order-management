FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
SHEETS_API_URL=YOUR_GOOGLE_APPS_SCRIPT_WEB_APP_URL

APP_WRITE_BUFFER_MS=600000
APP_DAILY_BACKUP_ENABLED=true
APP_MONTHLY_CLEANUP=true
APP_BACKUP_CHECK_INTERVAL_MS=3600000
CLIENT_MODE=multi_company
CLIENT_COMPANY_NAME=
# Keep empty in repo. Set real users/passwords only in deployment environment variables.
AUTH_USERS_JSON=[]
